{
  "name": "@rnzeus/heimdall-protocol",
  "version": "0.2.1",
  "description": "Wire protocol of Heimdall — Zod schemas and types for messages between the SDK and the desktop app",
  "license": "MIT",
  "author": "Volodymyr Dudkevych",
  "homepage": "https://heimdall.rnzeus.dev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rnzeus/heimdall-protocol.git"
  },
  "bugs": {
    "url": "https://github.com/rnzeus/heimdall-protocol/issues"
  },
  "keywords": [
    "heimdall",
    "protocol",
    "zod",
    "react-native",
    "devtools"
  ],
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "yarn clean && yarn build",
    "knip": "knip",
    "dupes": "jscpd",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "jscpd": "5.4.1",
    "knip": "6.41.0",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.6.0",
    "vite": "7.3.7",
    "vitest": "^5.0.3"
  },
  "packageManager": "yarn@4.6.0",
  "volta": {
    "node": "22.14.0",
    "yarn": "4.6.0"
  }
}
